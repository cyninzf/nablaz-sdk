{
  "name": "@nablaz/sdk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": "./src/index.ts",
    "./abis": "./src/generated/abis.ts",
    "./addresses": "./src/generated/addresses.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:fork": "vitest run --project fork",
    "gen:abis": "node --experimental-strip-types scripts/gen-abis.ts import",
    "gen:abis-ts": "node --experimental-strip-types scripts/gen-abis.ts ts",
    "gen:addresses": "node --experimental-strip-types scripts/gen-addresses.ts"
  },
  "dependencies": {
    "@x402/evm": "2.28.0",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@x402/core": "2.28.0",
    "@x402/fetch": "2.28.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
