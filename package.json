{
  "name": "nablaz-sdk",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:fork": "pnpm -r --workspace-concurrency=1 test:fork",
    "reader": "pnpm --filter @nablaz/reader start --schema reader",
    "mcp": "pnpm --silent --filter @nablaz/mcp start",
    "report:c-share": "pnpm --silent --filter @nablaz/reader report:c-share"
  },
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk>@hono/node-server": "2.1.4",
      "body-parser": "2.3.0",
      "qs": "6.16.0",
      "on-finished": "2.4.1",
      "ip-address": "10.7.4"
    }
  }
}
