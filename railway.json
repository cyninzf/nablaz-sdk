{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "bash scripts/railway-start.sh",
    "numReplicas": 1,
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 3600,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
