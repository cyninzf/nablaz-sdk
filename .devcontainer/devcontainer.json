{
  "name": "nablaz-sdk",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/node/.foundry/bin"
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "cyninzf/nablaz-protocol": {
          "permissions": {
            "contents": "read"
          }
        }
      }
    }
  }
}
